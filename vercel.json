{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/profiles/:handle",
      "destination": "/profile.html"
    },
    {
      "source": "/submissions/:id",
      "destination": "/submissions.html"
    },
    {
      "source": "/enter/:track",
      "destination": "/enter.html?track=:track"
    },
    {
      "source": "/guest/:handle",
      "destination": "/guest.html?handle=:handle"
    }
  ],
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/game/build-quiz",
      "permanent": false
    },
    {
      "source": "/spec",
      "destination": "/docs/research/701-canonical-state.md",
      "permanent": false
    },
    {
      "source": "/todo",
      "destination": "/TODO.md",
      "permanent": false
    },
    {
      "source": "/snap",
      "destination": "/docs/snap-design.md",
      "permanent": false
    },
    {
      "source": "/kit",
      "destination": "/docs/launch-kit.md",
      "permanent": false
    },
    {
      "source": "/brand",
      "destination": "/docs/brand-kit-2026-05-28.md",
      "permanent": false
    },
    {
      "source": "/llms",
      "destination": "/llms.txt",
      "permanent": false
    },
    {
      "source": "/raw",
      "destination": "/llms.txt",
      "permanent": false
    },
    {
      "source": "/log",
      "destination": "/changelog",
      "permanent": false
    },
    {
      "source": "/team",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/roster",
      "destination": "/p",
      "permanent": false
    },
    {
      "source": "/people",
      "destination": "/p",
      "permanent": false
    },
    {
      "source": "/winners",
      "destination": "/results",
      "permanent": false
    },
    {
      "source": "/winners.html",
      "destination": "/results",
      "permanent": false
    },
    {
      "source": "/enter",
      "destination": "/leaderboard",
      "permanent": false
    },
    {
      "source": "/enter.html",
      "destination": "/leaderboard",
      "permanent": false
    },
    {
      "source": "/vote",
      "destination": "/leaderboard",
      "permanent": false
    },
    {
      "source": "/vote.html",
      "destination": "/leaderboard",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://esm.sh; frame-src https://cal.com https://luma.com https://www.youtube.com; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/submission-status",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
